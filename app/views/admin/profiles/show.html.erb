<main class="growy-profile">

  <% if user_signed_in? %>

    <% favorites = current_user.favorites
        .includes(internship: :company)
        .order(created_at: :desc) %>

    <!-- АВАТАРКА И ИМЯ -->

    <section class="growy-profile-user">

      <div class="growy-profile-avatar">
        <%= image_tag "profile/growy-profile.webp",
            alt: "Аватар пользователя" %>
      </div>

      <h3 class="growy-profile-name">
        <%= current_user.name.presence || current_user.email.split("@").first %>
      </h3>

    </section>


    <!-- КОНТАКТЫ -->

    <section class="growy-profile-contacts">

      <h3 class="growy-profile-section-title">
        Контакты
      </h3>

      <div class="growy-profile-contact-list">

        <div class="growy-profile-contact">

          <h5 class="growy-profile-contact-label">
            Телефон для связи
          </h5>

          <p class="growy-profile-contact-value">
            <%= current_user.phone.presence || "Не указан" %>
          </p>

        </div>

        <div class="growy-profile-contact">

          <h5 class="growy-profile-contact-label">
            Почта для связи
          </h5>

          <p class="growy-profile-contact-value">
            <%= current_user.email %>
          </p>

        </div>

      </div>

    </section>


    <!-- ИЗБРАННЫЕ ВАКАНСИИ -->

    <section class="growy-profile-favorites">

      <h3 class="growy-profile-section-title">
        Избранные вакансии
      </h3>

      <div class="growy-profile-favorites-list">

        <% if favorites.any? %>

          <% favorites.each do |favorite| %>

            <% internship = favorite.internship %>
            <% company_name = internship.company.name %>

            <% direction = if ["Авито", "Яндекс"].include?(company_name)
                "Продуктовый дизайн"
              end %>

            <% company_color = {
              "Авито" => "#91d77c",
              "Яндекс" => "#9e9e9e"
            }.fetch(company_name, "#91d77c") %>

            <article class="growy-profile-card">

              <!-- КОМПАНИЯ И СЕРДЕЧКО -->

              <div class="growy-profile-card-top">

                <div class="growy-profile-card-company">

                  <span
                    class="growy-profile-company-dot"
                    style="--profile-company-dot: <%= company_color %>"
                  ></span>

                  <span>
                    <%= company_name %>
                  </span>

                </div>


                <!-- УДАЛИТЬ ИЗ ИЗБРАННОГО -->

                <%= form_with url: admin_favorite_path(favorite),
                    method: :delete,
                    class: "growy-profile-heart-form" do %>

                  <button
                    type="submit"
                    class="growy-profile-heart"
                    aria-label="Убрать из избранного"
                    title="Убрать из избранного"
                  >

                    <svg
                      viewBox="0 0 24 24"
                      width="24"
                      height="24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.7"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M20.8 8.6c0 4.7-8.8 10.1-8.8 10.1S3.2 13.3 3.2 8.6a4.7 4.7 0 0 1 8.8-2.2 4.7 4.7 0 0 1 8.8 2.2Z" />
                    </svg>

                  </button>

                <% end %>

              </div>


              <!-- НАЗВАНИЕ ВАКАНСИИ -->

              <h3 class="growy-profile-card-title">

                <%= link_to internship.title,
                    admin_internship_path(internship) %>

              </h3>


              <!-- ИНФОРМАЦИЯ -->

              <p class="growy-profile-card-meta">

                <%= [
                  internship.location,
                  direction,
                  internship.format
                ].reject(&:blank?).join(" • ") %>

              </p>

            </article>

          <% end %>

        <% else %>

          <div class="growy-profile-empty">

            <p>
              Пока здесь нет избранных вакансий.
            </p>

            <%= link_to "Найти стажировку",
                admin_internships_path,
                class: "growy-profile-empty-link" %>

          </div>

        <% end %>

      </div>

    </section>

    <div class="growy-profile-logout">

      <%= button_to "Выйти из аккаунта",
          destroy_user_session_path,
          method: :delete,
          class: "growy-profile-logout-button" %>

    </div>

  <% else %>

    <section class="growy-profile-login">

      <h3>Войдите, чтобы открыть профиль</h3>

      <%= link_to "Войти",
          new_user_session_path,
          class: "growy-profile-empty-link" %>

    </section>

  <% end %>

</main>

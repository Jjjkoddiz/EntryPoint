<div class="internships-page">
  
  <!-- ВЕРХНЯЯ ЧАСТЬ: Заголовок, теги и картинка -->
  <section class="internships-hero">
    <div class="internships-hero-content">
      <h1 class="internships-title">
        <span class="search-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2D2D2D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </span> 
        Что, если найти себя на Growy
      </h1>
      
      <div class="search-tags">
        <button class="tag">Коммуникационный дизайн</button>
        <button class="tag">Продуктовый дизайн</button>
        <button class="tag">Яндекс</button>
        <button class="tag">Удаленная работа</button>
        <button class="tag">Москва</button>
        <button class="tag">Все вакансии ↓</button>
      </div>
    </div>
    
    <div class="internships-hero-image">
      <!-- Замени "home/growy-hero.webp" на картинку мальчика с лупой, если она у тебя есть в assets/images -->
      <%= image_tag "home/growy-hero.webp", alt: "Мальчик с лупой" %>
    </div>
  </section>

  <!-- НИЖНЯЯ ЧАСТЬ: Сетка (Фильтры слева, Вакансии справа) -->
  <div class="internships-layout">
    
    <!-- ЛЕВАЯ КОЛОНКА (ФИЛЬТРЫ) -->
    <aside class="filters-sidebar">
      <button class="filter-btn">Направление дизайна ↓</button>
      <div class="filter-row">
        <button class="filter-btn">Навыки ↓</button>
        <button class="filter-btn">Формат ↓</button>
      </div>
      <div class="filter-row">
        <button class="filter-btn">Город ↓</button>
        <button class="filter-btn">Компания ↓</button>
      </div>
      <button class="filter-btn">Зарплата ↓</button>
      
      <button class="subscribe-search-btn">Подписаться на поиск</button>
    </aside>

    <!-- ПРАВАЯ КОЛОНКА (СПИСОК ВАКАНСИЙ) -->
    <main class="internships-main">
      <h2 class="internships-subtitle">Все вакансии</h2>
      
      <div class="internships-list">
        <% @internships.each do |internship| %>
          <div class="internship-card">
            <div class="card-header">
              <div class="card-company">
                <span class="company-dot"></span>
                <%= internship.company.name %>
              </div>
              
              <!-- Кнопка Избранного (сердечко) -->
              <%= form_with url: admin_favorites_path, method: :post, class: "heart-form" do |f| %>
                <%= f.hidden_field :internship_id, value: internship.id %>
                <button type="submit" class="heart-btn">
                  <svg width="20" height="18" viewBox="0 0 20 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M10 17.5L8.55 16.18C3.4 11.51 0 8.42 0 4.62C0 1.54 2.42 0 5.1 0C6.95 0 8.75 0.86 10 2.24C11.25 0.86 13.05 0 14.9 0C17.58 0 20 1.54 20 4.62C20 8.42 16.6 11.51 11.45 16.18L10 17.5Z" stroke="#2D2D2D" stroke-width="1.5"/>
                  </svg>
                </button>
              <% end %>
            </div>
            
            <h3 class="card-title">
              <%= link_to internship.title, admin_internship_path(internship), class: "card-link" %>
            </h3>
            
            <p class="card-meta">
              <%= internship.location %> • <%= internship.format %>
            </p>
          </div>
        <% end %>
      </div>
    </main>
    
  </div>
</div>
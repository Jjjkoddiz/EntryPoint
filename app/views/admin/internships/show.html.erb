%>


<main
  class="growy-detail"
  data-controller="internship-detail"
  data-internship-detail-company-value="<%= is_yandex ? 'yandex' : 'avito' %>"
>

  <!-- ВЕРХНЯЯ ЧАСТЬ -->

  <div class="growy-detail-top">

    <%= link_to admin_internships_path,
        class: "growy-detail-back",
        aria: { label: "Вернуться к стажировкам" } do %>

      <svg viewBox="0 0 24 24" width="24" height="24"
           fill="none" stroke="currentColor"
           stroke-width="1.8" stroke-linecap="round"
           stroke-linejoin="round" aria-hidden="true">
        <path d="m14 5-7 7 7 7M7 12h13" />
      </svg>

    <% end %>


    <div class="growy-detail-body">

      <!-- ЗАГОЛОВОК -->

      <div class="growy-detail-heading">

        <h1><%= @internship.title %></h1>

        <!-- ИЗБРАННОЕ -->

        <% if user_signed_in? %>

          <% if favorite %>

            <%= form_with url: admin_favorite_path(favorite),
                method: :delete,
                class: "growy-detail-heart-form" do %>

              <button
                type="submit"
                class="growy-detail-heart is-saved"
                aria-label="Убрать из избранного"
                aria-pressed="true"
              >
                <svg viewBox="0 0 24 24" width="24" height="24"
                     fill="none" stroke="currentColor"
                     stroke-width="1.8" aria-hidden="true">
                  <path d="M20.8 8.6c0 4.7-8.8 10.1-8.8 10.1S3.2 13.3 3.2 8.6a4.7 4.7 0 0 1 8.8-2.2 4.7 4.7 0 0 1 8.8 2.2Z" />
                </svg>
              </button>

            <% end %>

          <% else %>

            <%= form_with url: admin_favorites_path,
                method: :post,
                class: "growy-detail-heart-form" do %>

              <%= hidden_field_tag :internship_id, @internship.id %>

              <button
                type="submit"
                class="growy-detail-heart"
                aria-label="Добавить в избранное"
                aria-pressed="false"
              >
                <svg viewBox="0 0 24 24" width="24" height="24"
                     fill="none" stroke="currentColor"
                     stroke-width="1.8" aria-hidden="true">
                  <path d="M20.8 8.6c0 4.7-8.8 10.1-8.8 10.1S3.2 13.3 3.2 8.6a4.7 4.7 0 0 1 8.8-2.2 4.7 4.7 0 0 1 8.8 2.2Z" />
                </svg>
              </button>

            <% end %>

          <% end %>

        <% else %>

          <%= link_to new_user_session_path,
              class: "growy-detail-heart",
              aria: { label: "Войти, чтобы добавить в избранное" } do %>

            <svg viewBox="0 0 24 24" width="24" height="24"
                 fill="none" stroke="currentColor"
                 stroke-width="1.8" aria-hidden="true">
              <path d="M20.8 8.6c0 4.7-8.8 10.1-8.8 10.1S3.2 13.3 3.2 8.6a4.7 4.7 0 0 1 8.8-2.2 4.7 4.7 0 0 1 8.8 2.2Z" />
            </svg>

          <% end %>

        <% end %>

      </div>


      <!-- ИНФОРМАЦИЯ О ВАКАНСИИ -->

      <p class="growy-detail-meta">
        <%= [
          @internship.location,
          ("Продуктовый дизайн" if has_insights),
          @internship.format
        ].compact.reject(&:blank?).join(" • ") %>
      </p>


      <!-- КНОПКИ -->

      <div class="growy-detail-actions">

        <% if @internship.source_url.present? %>

          <%= link_to "Откликнуться",
              @internship.source_url,
              class: "growy-detail-btn growy-detail-btn--dark",
              target: "_blank",
              rel: "noopener noreferrer" %>

        <% end %>

        <% if has_insights %>

          <%= link_to "Получить инсайт от GROWY",
              "#growy-insights",
              class: "growy-detail-btn growy-detail-btn--lime" %>

        <% end %>

      </div>


      <!-- ОПИСАНИЕ -->

      <p class="growy-detail-lead">
        <%= intro %>
      </p>


      <!-- ТРИ АККОРДЕОНА ОТ КОМПАНИИ -->

      <% if company_sections.any? %>

        <div class="growy-detail-accordions"
             aria-label="Информация о стажировке">

          <% company_sections.each do |section| %>

            <details class="growy-detail-accordion">

              <summary>
                <%= section[:title] %>
                <span class="growy-detail-chevron"
                      aria-hidden="true"></span>
              </summary>

              <div class="growy-detail-accordion-content">
                <ul>
                  <% section[:items].each do |item| %>
                    <li><%= item %></li>
                  <% end %>
                </ul>
              </div>

            </details>

          <% end %>

        </div>

      <% end %>

    </div>
  </div>


  <!-- ИНСАЙТЫ GROWY -->

  <% if has_insights %>

    <section
      class="growy-detail-insights"
      id="growy-insights"
      aria-labelledby="growy-insights-title"
    >

      <div class="growy-detail-insights-inner">

        <h2
          class="growy-detail-insights-title"
          id="growy-insights-title"
        >
          Инсайты от Growy
        </h2>


        <!-- ПЕРЕКЛЮЧЕНИЕ ВКЛАДОК -->

        <div class="growy-detail-tabs"
             role="tablist"
             aria-label="Разделы инсайтов">

          <% [
            ["stages", "Этапы отбора"],
            ["qualities", "Что проверяют"],
            ["questions", "Вопросы на интервью"],
            ["experience", "Опыт кандидатов"]
          ].each_with_index do |(key, label), index| %>

            <button
              id="growy-tab-<%= key %>"
              type="button"
              role="tab"
              class="growy-detail-tab <%= 'is-active' if index.zero? %>"
              data-internship-detail-target="tab"
              data-tab="<%= key %>"
              data-action="click->internship-detail#selectTab keydown->internship-detail#tabKeydown"
              aria-controls="growy-panel-<%= key %>"
              aria-selected="<%= index.zero? %>"
              tabindex="<%= index.zero? ? 0 : -1 %>"
            >
              <%= label %>
            </button>

          <% end %>

        </div>


        <!-- 01. ЭТАПЫ ОТБОРА -->

        <div
          id="growy-panel-stages"
          class="growy-detail-panel"
          data-internship-detail-target="panel"
          data-panel="stages"
          role="tabpanel"
          aria-labelledby="growy-tab-stages"
        >

          <div class="growy-detail-stage-track">

            <% stages.each do |stage| %>

              <button
                type="button"
                class="growy-detail-stage"
                data-action="click->internship-detail#flipStage"
                aria-label="Подробнее об этапе <%= stage[:title] %>"
                aria-pressed="false"
              >

                <span class="growy-detail-stage-inner">

                  <!-- ЛИЦЕВАЯ СТОРОНА -->

                  <span class="growy-detail-stage-front">

                    <span class="growy-detail-stage-toggle"
                          aria-hidden="true"></span>

                    <span class="growy-detail-stage-art">
                      <%= image_tag stage[:image],
                          alt: "",
                          loading: "lazy" %>
                    </span>

                    <span class="growy-detail-stage-name">
                      <%= stage[:title] %>
                    </span>

                  </span>


                  <!-- ОБРАТНАЯ СТОРОНА -->

                  <span class="growy-detail-stage-back">

                    <span class="growy-detail-stage-toggle"
                          aria-hidden="true"></span>

                    <span class="growy-detail-stage-back-copy">

                      <span class="growy-detail-stage-back-title">
                        <%= stage[:heading] %>
                      </span>

                      <span class="growy-detail-stage-back-text">
                        <%= stage[:description] %>
                      </span>

                    </span>

                  </span>

                </span>

              </button>

            <% end %>

          </div>
        </div>


        <!-- 02. ЧТО ПРОВЕРЯЮТ -->

        <div
          id="growy-panel-qualities"
          class="growy-detail-panel"
          data-internship-detail-target="panel"
          data-panel="qualities"
          role="tabpanel"
          aria-labelledby="growy-tab-qualities"
          hidden
        >

          <div class="growy-detail-qualities">

            <% qualities.each do |quality| %>

              <div class="growy-detail-quality">

                <div class="growy-detail-quality-art">
                  <%= image_tag quality[:image],
                      alt: "",
                      loading: "lazy" %>
                </div>

                <h3><%= quality[:title] %></h3>

              </div>

            <% end %>

          </div>

        </div>


        <!-- 03. ВОПРОСЫ НА ИНТЕРВЬЮ -->

        <div
          id="growy-panel-questions"
          class="growy-detail-panel"
          data-internship-detail-target="panel"
          data-panel="questions"
          role="tabpanel"
          aria-labelledby="growy-tab-questions"
          hidden
        >

          <div class="growy-detail-section-intro">

            <h3>
              Вопросы, к которым стоит подготовиться
            </h3>

            <p>
              На интервью чаще проверяют ход мысли:
              как кандидат понимает задачу,
              аргументирует решения и связывает
              дизайн с продуктовой целью.
            </p>

          </div>


          <div class="growy-detail-quiz-layout">

            <!-- СПИСОК ТЕМ -->

            <div
              class="growy-detail-topics"
              data-internship-detail-target="topics"
              role="group"
              aria-label="Темы вопросов"
            ></div>


            <!-- КАРТОЧКА ВОПРОСА -->

            <div class="growy-detail-quiz-right">

              <div class="growy-detail-quiz-controls">

                <button
                  class="growy-detail-quiz-arrow"
                  type="button"
                  data-action="click->internship-detail#previousQuestion"
                  aria-label="Предыдущий вопрос"
                >
                  <svg viewBox="0 0 24 24" width="24" height="24"
                       fill="none" stroke="currentColor"
                       stroke-width="1.8" aria-hidden="true">
                    <path d="m14 5-7 7 7 7M7 12h13" />
                  </svg>
                </button>


                <div class="growy-detail-quiz-stack">

                  <button
                    type="button"
                    class="growy-detail-question-card"
                    data-internship-detail-target="questionCard"
                    data-action="click->internship-detail#flipQuestion"
                    aria-label="Перевернуть карточку вопроса"
                    aria-pressed="false"
                  >

                    <!-- ЛИЦЕВАЯ СТОРОНА -->

                    <span class="growy-detail-question-face growy-detail-question-front">

                      <span
                        class="growy-detail-question-category"
                        data-internship-detail-target="questionCategory"
                      ></span>

                      <span
                        class="growy-detail-question-main"
                        data-internship-detail-target="questionTitle"
                      ></span>

                      <span class="growy-detail-question-hint">
                        Нажми, чтобы увидеть разбор
                      </span>

                      <span
                        class="growy-detail-question-position"
                        data-internship-detail-target="questionPosition"
                      ></span>

                    </span>


                    <!-- ОБРАТНАЯ СТОРОНА -->

                    <span
                      class="growy-detail-question-face growy-detail-question-back"
                      aria-hidden="true"
                    >

                      <span
                        class="growy-detail-question-category"
                        data-internship-detail-target="questionBackCategory"
                      ></span>

                      <span class="growy-detail-question-back-copy">

                        <strong
                          data-internship-detail-target="questionCriteriaLabel"
                        ></strong>

                        <span
                          data-internship-detail-target="questionCriteria"
                        ></span>

                        <strong>Чек-лист</strong>

                        <span
                          data-internship-detail-target="questionChecklist"
                        ></span>

                      </span>

                      <span
                        class="growy-detail-question-position"
                        data-internship-detail-target="questionBackPosition"
                      ></span>

                    </span>

                  </button>

                </div>


                <button
                  class="growy-detail-quiz-arrow"
                  type="button"
                  data-action="click->internship-detail#nextQuestion"
                  aria-label="Следующий вопрос"
                >
                  <svg viewBox="0 0 24 24" width="24" height="24"
                       fill="none" stroke="currentColor"
                       stroke-width="1.8" aria-hidden="true">
                    <path d="m10 5 7 7-7 7M17 12H4" />
                  </svg>
                </button>

              </div>


              <!-- ПАГИНАЦИЯ -->

              <div
                class="growy-detail-quiz-dots"
                data-internship-detail-target="dots"
                aria-label="Номер вопроса"
              ></div>

            </div>

          </div>

        </div>


        <!-- 04. ОПЫТ КАНДИДАТОВ -->

        <div
          id="growy-panel-experience"
          class="growy-detail-panel"
          data-internship-detail-target="panel"
          data-panel="experience"
          role="tabpanel"
          aria-labelledby="growy-tab-experience"
          hidden
        >

          <div class="growy-detail-section-intro">

            <h3>
              Задали вопросы <%= candidate_name %>
            </h3>

            <p>
              <%= candidate_intro %>
            </p>

          </div>


          <div class="growy-detail-experience-accordions">

            <% candidate_answers.each do |question, answer| %>

              <details class="growy-detail-accordion growy-detail-accordion--experience">

                <summary>
                  <%= question %>

                  <span class="growy-detail-chevron"
                        aria-hidden="true"></span>
                </summary>

                <div class="growy-detail-accordion-content">
                  <p><%= answer %></p>
                </div>

              </details>

            <% end %>

          </div>

        </div>

      </div>

    </section>

  <% end %>

</main>

 <header class="growy-header">
  <%= link_to admin_home_index_path, class: "growy-logo growy-logo-header" do %>
    <%= image_tag "home/growy-logo-header.webp", alt: "GROWY" %>
  <% end %>

  <nav class="growy-nav" aria-label="Навигация администратора">

    <%= link_to "О нас", about_path,
        class: ("is-active" if current_page?(about_path)) %>

    <%= link_to "Стажировки", admin_internships_path,
        class: ("is-active" if request.path.start_with?("/admin/internships")) %>

    <% if user_signed_in? && current_user.admin? %>
      <%= link_to "Профиль", admin_profile_path,
          class: ("is-active" if current_page?(admin_profile_path)) %>
    <% else %>
      <%= link_to "Профиль", new_user_session_path,
          class: ("is-active" if current_page?(new_user_session_path)) %>
    <% end %>

  </nav>
</header>